digraph RepoLoopWorkflow {
  graph [
    rankdir=LR,
    bgcolor="#FFFFFF",
    pad="0.35",
    nodesep="0.42",
    ranksep="0.70",
    splines=ortho,
    newrank=true,
    fontname="Helvetica"
  ];

  node [
    shape=box,
    style="rounded,filled",
    fillcolor="#F8FAFC",
    color="#334155",
    fontcolor="#0F172A",
    fontname="Helvetica",
    fontsize=11,
    margin="0.18,0.12"
  ];

  edge [
    color="#64748B",
    fontcolor="#334155",
    fontname="Helvetica",
    fontsize=9,
    arrowsize=0.75
  ];

  repo [label="Local Git\nrepository", shape=folder, fillcolor="#E2E8F0"];

  subgraph cluster_current {
    label="Available now";
    color="#2563EB";
    penwidth=1.5;
    style="rounded";

    scan [label="Deterministic\nread-only scan", fillcolor="#DBEAFE"];
    snapshot [label="RepoSnapshot\nfacts + evidence", shape=note, fillcolor="#EFF6FF"];
    capsule [label="RepoCapsule\npolicy + limits", shape=note, fillcolor="#EFF6FF"];
    proof [label="Proof report\n5 contract checks", fillcolor="#DCFCE7"];
    interfaces [label="CLI  |  TUI  |  GUI  |  JSON", fillcolor="#F1F5F9"];

    scan -> snapshot;
    snapshot -> capsule;
    capsule -> proof;
    capsule -> interfaces;
  }

  subgraph cluster_consumers {
    label="Use the contract";
    color="#A78BFA";
    style="rounded";

    agents [label="Codex  |  Claude Code\nOpenCode  |  custom runtime", fillcolor="#F3E8FF"];
  }

  subgraph cluster_planned {
    label="Planned governed runtime";
    color="#94A3B8";
    style="rounded,dashed";

    controller [label="Checkpointed\ncontroller", style="rounded,filled,dashed", fillcolor="#F8FAFC"];
    worktree [label="Isolated\nworktree", style="rounded,filled,dashed", fillcolor="#F8FAFC"];
    verify [label="Independent\nchange verifier", style="rounded,filled,dashed", fillcolor="#F8FAFC"];
    result [label="Verified result\nor resumable stop", shape=doublecircle, style="filled,dashed", fillcolor="#F8FAFC"];

    controller -> worktree [style=dashed];
    worktree -> verify [style=dashed];
    verify -> result [style=dashed];
  }

  repo -> scan;
  interfaces -> agents;
  capsule -> controller [style=dashed, xlabel="future adapter"];
}
